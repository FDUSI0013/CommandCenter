# Fulcrum Ops — public edge.
#
# Terminates TLS, serves the console's static assets, and proxies everything
# under /api to the control plane. The telemetry engine is not represented
# here at all: it has no route in, by design.

{
	email ops@fulcrumops.com
	servers {
		trusted_proxies static private_ranges
	}
}

(common) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# Every proxy block below carries the same three settings, for three reasons.
	#
	# lb_try_duration / lb_try_interval. The control plane is one container. While
	# it restarts — every deploy, every out-of-memory kill, every autoheal —
	# nothing listens on 8080 for 15 to 40 seconds, and with no retry window the
	# edge answered each request in that gap with an instant 502: the console
	# said it could not reach the control plane, and an agent's ingest POST was
	# refused outright. Now a request whose connection is refused is held and
	# re-dialled for up to 30 s. Only a failed DIAL is retried for a POST, so
	# nothing can be delivered twice: a refused connection sent nothing.
	#
	# keepalive 60s. The edge reuses idle upstream connections, by default for two
	# minutes. If the server behind it drops an idle connection sooner, the edge
	# will sooner or later send a request down a socket that has just closed —
	# and a POST cannot be replayed, so that is a 502. The side that reuses must
	# let go first: 60 s here, 75 s in the control plane (--timeout-keep-alive in
	# apps/control-plane/Dockerfile; uvicorn's own default is 5 s).
	#
	# response_header_timeout. This was `read_timeout 24h` on every API route, so
	# a request into a wedged worker was held by the edge for a day: only the
	# browser ever gave up. 150 s is deliberately longer than the longest wait
	# any client of ours has (the console allows a Prompt Studio run 135 s), so
	# the edge is never the first to abandon a request that is still being
	# worked on — and a caller with no timeout of its own gets a 504 in minutes.

	handle /api/* {
		# The two server-sent-event streams. They answer their headers at once,
		# so the header timeout above still applies; what they need is to be
		# flushed frame by frame and allowed to stay open. read_timeout is the
		# wait for the NEXT read, not for the whole response, and both streams
		# send a keep-alive comment every 15 s: five silent minutes is a dead
		# stream, not a quiet one.
		@stream path /api/v1/runs/stream /api/v1/deployments/*/stream
		handle @stream {
			reverse_proxy 127.0.0.1:8080 {
				header_up X-Real-IP {remote_host}
				flush_interval -1
				lb_try_duration 30s
				lb_try_interval 250ms
				transport http {
					keepalive 60s
					response_header_timeout 150s
					read_timeout 5m
				}
			}
		}

		# Everything else under /api: the API itself and its docs.
		handle {
			# The largest body the API accepts is an ingest batch of 8 MiB, and
			# it refuses more with its own structured 413. This ceiling sits just
			# above that, for every OTHER route — none of which has a limit of
			# its own, so a gigabyte of JSON would otherwise be read into a
			# worker's memory before anything looked at it.
			request_body {
				max_size 10MB
			}
			reverse_proxy 127.0.0.1:8080 {
				header_up X-Real-IP {remote_host}
				lb_try_duration 30s
				lb_try_interval 250ms
				transport http {
					keepalive 60s
					response_header_timeout 150s
				}
			}
		}
	}

	handle /health {
		reverse_proxy 127.0.0.1:8080 {
			lb_try_duration 30s
			lb_try_interval 250ms
			transport http {
				keepalive 60s
				# The endpoint bounds its own checks at 3 s each.
				response_header_timeout 30s
			}
		}
	}

	# OpenTelemetry ingest for agents that already speak OTLP/HTTP.
	handle /v1/traces {
		request_body {
			max_size 10MB
		}
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
			lb_try_duration 30s
			lb_try_interval 250ms
			transport http {
				keepalive 60s
				response_header_timeout 150s
			}
		}
	}

	# The console: static files, SPA fallback to index.html.
	#
	# The assets have fixed names — js/app.js, not js/app.<hash>.js — so a
	# browser cannot tell a cached copy from the current one by URL. Without an
	# explicit Cache-Control, it applies heuristic freshness and may keep serving
	# a previous deployment's JavaScript against this deployment's HTML, which
	# fails in ways that look like the app is simply broken. "no-cache" means
	# revalidate before reuse, not "do not store": an unchanged file still costs
	# one conditional request answered with 304.
	handle {
		root * /srv/fulcrum-ops
		header Cache-Control "no-cache"

		# A missing *asset* must 404. The SPA fallback below rewrites any
		# unknown path to index.html, and for a route that is exactly right —
		# but applied to js/gone.js it answers 200 with HTML, which the browser
		# then tries to parse as JavaScript. A file that was deleted in a deploy
		# would look present and fail confusingly instead of failing plainly.
		@asset path_regexp \.(js|css|map|png|jpg|jpeg|svg|ico|webp|woff2?|ttf|json|txt)$
		handle @asset {
			file_server
		}

		# Everything else is the single page — except a directory that carries
		# its own index (the operator manual at /docs/), which serves that.
		handle {
			try_files {path} {path}/index.html /index.html
			file_server
		}
	}

	log {
		output file /var/log/caddy/fulcrum-ops.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# Which names this host answers to, and therefore which certificates it asks
# for. Set in /etc/default/caddy so the file itself does not change between
# staging and production:
#
#   staging     FULCRUM_SITE_ADDRESSES="32-196-146-8.sslip.io"
#   production  FULCRUM_SITE_ADDRESSES="controlplane.fdprod.net, 32-196-146-8.sslip.io"
#
# Naming the production domain before DNS points here would make certificate
# issuance fail and retry in a loop, so it is added at cutover, not before.
{$FULCRUM_SITE_ADDRESSES} {
	import common
}
