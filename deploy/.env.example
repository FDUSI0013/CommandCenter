# Fulcrum Ops — deployment configuration.
#
# Copy to .env next to docker-compose.yml and fill in every value. Nothing here
# has a usable default: compose refuses to start rather than run a public
# service on a guessable password.
#
# Generate the secrets:
#   openssl rand -base64 36                                  # passwords
#   docker run --rm fulcrum-ops/control-plane:latest \
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- what the public sees --------------------------------------------------
PUBLIC_BASE_URL=https://controlplane.example.net

# ---- our control plane -----------------------------------------------------
APP_TAG=latest
APP_SECRET_KEY=            # signs browser session tokens
APP_ENCRYPTION_KEY=        # Fernet key; encrypts the secrets vault at rest
APP_DB_NAME=fulcrum_ops
APP_DB_USER=fulcrum
APP_DB_PASSWORD=
# Python package the engine's metric runner exposes for user-defined metric
# code; guardrail rules mirrored into the engine import
# `<this>.evaluation.metrics`. Deployment-specific — the vendored engine's
# library name is set here on the host and never appears in this repository.
# Empty disables the mirror (inline guardrail enforcement is unaffected).
ENGINE_METRIC_LIBRARY=

# ---- the private telemetry engine and its datastores -----------------------
# Where the engine images come from. Leave IMAGE_PREFIX as-is to run images built
# on this host by engine/build.sh; set it to the registry path after mirroring:
#   IMAGE_PREFIX=155954279114.dkr.ecr.us-east-1.amazonaws.com/fulcrum-ops
IMAGE_PREFIX=fulcrum-ops
ENGINE_TAG=1.0.0

STATE_DB_NAME=fulcrum_engine
STATE_DB_USER=fulcrum
STATE_DB_PASSWORD=
STATE_DB_ROOT_PASSWORD=

ANALYTICS_DB_NAME=fulcrum_analytics
ANALYTICS_DB_USER=fulcrum
ANALYTICS_DB_PASSWORD=

CACHE_PASSWORD=

BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=
BLOB_BUCKET=fulcrum-attachments

# ---- first sign-in ---------------------------------------------------------
# Bootstrap the owner account interactively; compose deliberately passes
# neither value into the container, so credentials never sit in an env file:
#   docker compose exec control-plane fulcrum-ops-api bootstrap \
#     --workspace "Acme" --email you@acme.test --name "Your Name"
# (the command prompts for the password and prints a once-only admin API key)

# ---- Prompt Studio execution (optional) ------------------------------------
# With these unset, Run Prompt answers 503 model_unavailable naming what is
# missing. For Azure the MODEL is the deployment name in the URL path.
PROMPT_STUDIO_ENDPOINT=
PROMPT_STUDIO_API_KEY=
PROMPT_STUDIO_MODEL=
PROMPT_STUDIO_API_VERSION=2024-10-21
